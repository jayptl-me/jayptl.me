# Netlify/Cloudflare Pages headers configuration
# Headers for all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Cache control for static assets
/assets/resumes/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=2592000

/js/*
  Cache-Control: public, max-age=2592000

# HTML files - no cache
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Service worker - no cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Versioned resume PDFs: attachments of canonical /resume until a role
# has distinct content. Static-host parity for server.js PDF headers.
# (Google: X-Robots-Tag is the only noindex that works for PDFs;
# Link rel=canonical HTTP header consolidates signals to /resume.)
/assets/resumes/*.pdf
  X-Robots-Tag: noindex
  Link: <https://jayptl.me/resume>; rel="canonical"
