# jayptl.me API settings. Copy to .env for local runs; on Render, set these
# in the service's Environment tab. Never commit real values.

# Server
PORT=8787
# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGIN=https://jayptl.me
# The site's address, used for the cancel link written into each invite.
SITE_URL=https://jayptl.me
# Pages that may be counted come from this sitemap (refreshed every 6 hours).
SITEMAP_URL=https://jayptl.me/sitemap.xml
# Headers read for the visitor's IP (rate limits only, never stored), first
# match wins. The host's own forwarded list can be faked by visitors, so
# the edge network's headers come first. Leave as is unless you move hosts.
TRUSTED_IP_HEADERS=cf-connecting-ip,true-client-ip,x-forwarded-for

# Storage (Redis Cloud free database, use the rediss:// TLS URL)
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# Secrets: long random strings, e.g. `openssl rand -base64 32`
# TICK_SECRET   your per-minute scheduler sends it as "Authorization: Bearer ..."
#               It can only run the tick; it cannot read any guest data.
# ADMIN_SECRET  typed into /admin to set "now playing", and the only key
#               for GET /v1/export (the backup, which holds guest details)
# TOKEN_SECRET  signs booking cancel links
TICK_SECRET=
ADMIN_SECRET=
TOKEN_SECRET=

# Google Calendar (see README, "Google setup")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Booking rules (times are in BOOKING_TIMEZONE)
BOOKING_TIMEZONE=Asia/Kolkata
BOOKING_HOURS=10:00-13:00,14:00-18:00
# 0 = Sunday ... 6 = Saturday
BOOKING_DAYS=1,2,3,4,5
BOOKING_SLOT_MINUTES=15
BOOKING_BUFFER_MINUTES=5
BOOKING_MIN_NOTICE_MINUTES=120
BOOKING_HORIZON_DAYS=14
BOOKING_MAX_PER_DAY=4
MEET_LEAD_MINUTES=15
BOOKING_KEEP_DAYS=30

# Steam (optional, for "now playing"). Key: steamcommunity.com/dev/apikey
# STEAM_ID is your 64-bit id; profile "Game details" must be Public.
STEAM_API_KEY=
STEAM_ID=
